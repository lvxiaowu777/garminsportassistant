# 环境变量模板 —— 复制成 .env 并填入真实值
#
#   copy .env.example .env
#
# .env 已 gitignore，不会进版本库。

# ── LLM ──
DEEPSEEK_API_KEY=
# 备用 provider（代码里可选）
STEPFUN_API_KEY=
ARK_API_KEY=
# Claude（Anthropic 原生协议，走 llm/anthropic.py）
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# ── 天气（和风天气）──
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# ── 数据库 ──
# 本地开发（MySQL 8，推荐；SQLite 已废弃）：
DATABASE_URL=mysql+pymysql://root:密码@127.0.0.1:3306/garmin_coach?charset=utf8mb4
# 服务器：
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/garmin_coach?charset=utf8mb4

# ── 鉴权 ──
# 生产环境必须设置，否则用代码里的开发默认值
JWT_SECRET=

# ── 运行时（代码在 garmin_coach/settings.py；不填就用括号里的默认值）──
# Agent 空闲多久回收（秒，默认 3600）。压测时可调小到 10 验证回收逻辑
SESSION_TTL_SECONDS=3600
# 内存里最多驻留多少个会话（LRU，默认 200）
MAX_SESSIONS=200
# 后台扫描过期会话的间隔（秒，默认 300）
SESSION_REAP_INTERVAL_SECONDS=300
# 一轮对话最多几次「模型 ↔ 工具」往返（默认 8）
AGENT_MAX_TURNS=8
# 模型温度（默认 0.7；跑评测建议 0）
AGENT_TEMPERATURE=0.7
# 日常同步默认拉几天（默认 2；首次绑表才做多天 backfill）
SYNC_DAYS_DEFAULT=2
