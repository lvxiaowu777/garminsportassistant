# 环境变量模板 —— 复制成 .env 并填入真实值
#
#   copy .env.example .env
#
# .env 已 gitignore，不会进版本库。

# ── LLM ──
DEEPSEEK_API_KEY=
# 备用 provider（代码里可选）
STEPFUN_API_KEY=
ARK_API_KEY=

# ── 天气（和风天气）──
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# ── 数据库 ──
# 本地开发（SQLite，路径相对项目根）：
DATABASE_URL=sqlite:///./src/data/garmin_coach.db
# 服务器（MySQL）：
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/garmin_coach?charset=utf8mb4

# ── 鉴权 ──
# 生产环境必须设置，否则用代码里的开发默认值
JWT_SECRET=
